# Supabase PostgreSQL
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# JWT
SECRET_KEY=your-secret-key-min-32-chars-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Resend (email alerts) — Railway blocks SMTP, use Resend instead
# Get your key at: https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Optional: email address that receives alerts (defaults to GMAIL_USER if set)
ALERT_EMAIL=forai3101@gmail.com
# Optional: custom "from" address (requires verified domain in Resend dashboard)
# Leave blank to use Resend's shared domain (onboarding@resend.dev) — works immediately
RESEND_FROM=

# Legacy Gmail vars — no longer used for sending, kept only as ALERT_EMAIL fallback
GMAIL_USER=forai3101@gmail.com
GMAIL_APP_PASSWORD=

# Groq
GROQ_API_KEY=gsk_xxxxxxxxxxxx

# App
APP_NAME=SmartStock Pro
DEBUG=False
